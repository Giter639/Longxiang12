<?xml version="1.0" encoding="utf-8"?>
<!-- P01–P14 页面通用模板（UI 改版）：
     标题 + 实时状态卡 + 动态容器；开发期 owner/hint 标签保留但默认隐藏（BasePageFragment 控制）
     各页面只改自己的 Fragment（ui/pages/），布局不够用就复制本文件改名 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/page_padding">

        <TextView
            android:id="@+id/page_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/focusdu_ink" />

        <TextView
            android:id="@+id/page_owner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:visibility="gone"
            android:textColor="@color/focusdu_text_hint" />

        <!-- 实时状态卡：白底描边圆角，替代旧灰底块 -->
        <TextView
            android:id="@+id/page_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:background="@drawable/bg_status_card"
            android:padding="14dp"
            android:textColor="@color/focusdu_ink_secondary" />

        <TextView
            android:id="@+id/page_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp"
            android:visibility="gone"
            android:textColor="@color/focusdu_text_hint" />

        <!-- 各页面自己的控件挂这里（代码动态添加或 include 具体布局） -->
        <LinearLayout
            android:id="@+id/page_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
